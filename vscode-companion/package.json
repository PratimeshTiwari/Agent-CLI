{
  "name": "cli-agent-companion",
  "displayName": "Agent CLI Companion",
  "description": "Chat with the local Agent CLI from the sidebar, plus editor state, diagnostics, Add to Agent Chat, and plan review.",
  "version": "1.8.4",
  "publisher": "pratimesh-tiwari",
  "author": {
    "name": "Pratimesh Tiwari"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentCli.addToChat",
        "title": "Add to Agent Chat",
        "category": "Agent CLI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentCli.openPlan",
        "title": "Open Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.approvePlan",
        "title": "Approve Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.submitReview",
        "title": "Submit Plan Review",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.rejectPlan",
        "title": "Reject Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.commentOnPlan",
        "title": "Comment on Plan Section",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.focusChat",
        "title": "Focus Chat",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.startAgent",
        "title": "Start Agent",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.acceptDiff",
        "title": "Accept Agent Edit",
        "category": "Agent CLI",
        "icon": "$(check)"
      },
      {
        "command": "agentCli.rejectDiff",
        "title": "Reject Agent Edit",
        "category": "Agent CLI",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "agentCli.addToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "agentCli.focusChat",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "agentCli.commentOnPlan",
          "when": "false"
        },
        {
          "command": "agentCli.acceptDiff",
          "when": "resourceScheme == agent-cli-proposed"
        },
        {
          "command": "agentCli.rejectDiff",
          "when": "resourceScheme == agent-cli-proposed"
        }
      ],
      "editor/title": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1",
          "when": "editorTextFocus"
        },
        {
          "command": "agentCli.acceptDiff",
          "group": "navigation@1",
          "when": "resourceScheme == agent-cli-proposed"
        },
        {
          "command": "agentCli.rejectDiff",
          "group": "navigation@2",
          "when": "resourceScheme == agent-cli-proposed"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCli",
          "title": "Agent CLI",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "agentCli": [
        {
          "type": "webview",
          "id": "agentCli.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PratimeshTiwari/Agent-CLI"
  },
  "scripts": {
    "vscode:prepublish": "node scripts/sync-panel.js"
  }
}
